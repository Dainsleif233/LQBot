# ===== QQ bot credentials (from QQ open platform console) =====
# App ID
APP_ID=
# App Secret (used both for access_token and webhook signature)
APP_SECRET=
# Optional separate webhook signing secret; falls back to APP_SECRET if empty
WEBHOOK_SECRET=

# ===== OpenAPI base URL =====
# production: https://api.sgroup.qq.com
# sandbox:    https://sandbox.api.sgroup.qq.com
QQ_API_BASE=https://api.sgroup.qq.com

# ===== Permission system =====
# Super admin (level 3) user openid
SUPER_ADMIN_OPENID=

# Default level for group-chat scene ("group admin" scene value), default 1.
# Set to 0 to make ordinary group members level 0 by default.
GROUP_SCENE_LEVEL=1

# Whether to call group member API to detect real group admins (default true).
# When false, group scene always returns GROUP_SCENE_LEVEL.
CHECK_GROUP_ADMIN=true

# Whether to verify each callback's Ed25519 signature (default false; true is safer).
VERIFY_EVENT_SIGNATURE=false
